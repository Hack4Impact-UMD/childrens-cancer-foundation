rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function role() {
      return request.auth != null ? request.auth.token.role : null;
    }

    match /pdfs/{fileName} {
      // Admins and reviewers read everything; applicants only what they uploaded.
      // Objects written by the submitApplication cloud function and by
      // uploadFileToStorage both carry customMetadata.uploadedBy.
      allow read: if request.auth != null && (
        role() == 'admin' ||
        role() == 'reviewer' ||
        resource.metadata.uploadedBy == request.auth.uid
      );

      // Authenticated uploads: PDF, <50MB, and must declare the uploader truthfully.
      allow write: if request.auth != null
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf')
        && request.resource.metadata.uploadedBy == request.auth.uid;
    }

    // Anything outside pdfs/ is admin-only.
    match /{allPaths=**} {
      allow read: if request.auth != null && request.auth.token.role == 'admin';
    }
  }
}
