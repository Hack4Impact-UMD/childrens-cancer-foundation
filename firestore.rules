rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is an admin
    function isAdmin() {
      return request.auth != null && 
        request.auth.token.role == 'admin';
    }
    
    // Helper function to check if user is an applicant
    function isApplicant() {
      return request.auth != null && 
        request.auth.token.role == 'applicant';
    }
    
    // Helper function to check if user is a reviewer
    function isReviewer() {
      return request.auth != null && 
        request.auth.token.role == 'reviewer';
    }
    
    // Applications collection rules
    match /applications/{applicationId} {
      allow read: if isAdmin() || isReviewer() || (isApplicant() && request.auth.uid == resource.data.creatorId);
      allow create: if isAdmin() || (isApplicant()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.status == 'draft');
      allow update: if isAdmin() || (isApplicant()
        && resource.data.creatorId == request.auth.uid
        && resource.data.status == 'draft'
        && request.resource.data.status == 'draft'
        && request.resource.data.creatorId == resource.data.creatorId)
        // Visual archive flag: applicants may toggle ONLY `archived` (bool) on
        // their own docs, draft or submitted. Nothing else may change.
        || (isApplicant()
        && resource.data.creatorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived'])
        && request.resource.data.archived is bool);
      allow delete: if isAdmin() || (isApplicant() && resource.data.creatorId == request.auth.uid && resource.data.status == 'draft');
    }
    
    // FAQs collection rules
    match /FAQs/{faqId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // About Pages collection rules
    match /AboutPages/{aboutId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Applicants
    match /applicants/{applicantId} {
      allow read: if isAdmin() || isReviewer() || request.auth.uid == applicantId;
      allow write: if isAdmin() || request.auth.uid == applicantId;
    }

    // Reviewers
    match /reviewers/{reviewerId} {
      allow read: if isAdmin() || isReviewer();
      allow write: if isAdmin() || request.auth.uid == reviewerId;
    }
    
    // Application Cycles
    match /applicationCycles/{cycleId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Decision Data
    match /decision-data/{decisionId} {
      allow read: if isAdmin() || isReviewer() || (isApplicant() && request.auth.uid == get(/databases/$(database)/documents/applications/$(decisionId)).data.creatorId);
      allow write: if isAdmin();
    }
    
    // Post Grant Reports collection rules
    match /post-grant-reports/{reportId} {
      // Allow applicants to create their own reports
      allow create: if isApplicant() && 
        request.resource.data.userId == request.auth.uid;
      
      // Allow applicants to read their own reports
      allow read: if isApplicant() && 
        resource.data.userId == request.auth.uid;
      
      // Allow applicants to update their own reports
      allow update: if isApplicant() && 
        resource.data.userId == request.auth.uid;
      
      // Allow admins to read and update all reports
      allow read, update: if isAdmin();
    }
    
    // Reviewer Whitelist
    match /reviewer-whitelist/{whitelistId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    // Reviews (parent doc: { applicationId, createdAt })
    match /reviews/{applicationId} {
      allow read: if isAdmin() || isReviewer();
      allow create, update: if isAdmin() || isReviewer();

      // Individual review documents
      match /reviewers/{reviewId} {
        allow read: if isAdmin() || isReviewer();
        allow create, delete: if isAdmin();
        allow update: if isAdmin() ||
          (isReviewer() && resource.data.reviewerId == request.auth.uid);
      }
    }
  }
}